# 参赛版部署环境变量（deployments/competition/docker-compose.yml）
#
# 复制成 .env 放在**同一目录**（compose 只读同目录的 .env）：
#   cp .env.example .env

CONGORAG_IMAGE_TAG=cup

# 数据库密码（只在数据卷第一次初始化时生效，之后改它无效）
CONGORAG_PG_PASSWORD=congorag

# 宿主机映射端口（默认只绑 127.0.0.1，公网访问请配反向代理）
CONGORAG_PORT=3210

# 大文档解析超时（541 页实测约 2 分钟，10 分钟是安全余量）
CONGORAG_PDF_TIMEOUT=10m
