# ConGoRAG 本机开发 / 发布用的环境变量样例
#
# 【这个文件和 deployments/startup/.env.example 不是同一个东西】
#   · 这个 ← 给**开发者和发布者**：api / worker 跑在宿主机上（make dev），
#     数据库是 deployments/docker/docker-compose.yml 起的那个 PostgreSQL；
#   · deployments/startup/.env.example ← 给**只想用的人**：四个服务全在
#     容器里，值也不一样（那边的 DB 主机名是 compose 服务名 postgres）。
# 把这份的内容搬到那边去会连不上库——主机名 127.0.0.1 在容器里指向它自己。
#
# 【怎么用】复制成 .env（.env 在 .gitignore 里，不会进仓库）。
# 注意本项目**不自动加载 .env**：Makefile 用自己算出来的默认值，只有
# scripts/release.mjs 会读仓库根的 .env 找 GITHUB_TOKEN。也就是说这里的
# CONGORAG_* 只有在你手动 export / 或用支持 .env 的工具时才生效——
# 它们列在这里的作用是"记录有哪些可调项"，不是"改了就一定生效"。
#
# ── 数据库 ──────────────────────────────────────────────────────
#
# 开发库。make up 起的那个 PostgreSQL 在 127.0.0.1:5432。
# Makefile 里 export 的也是这个值（见 Makefile 的 DB_URL），所以这一行
# 在正常开发流程里是冗余的——列出来是为了让"连的是哪个库"一眼可见。
CONGORAG_DB_URL=postgres://postgres:postgres@127.0.0.1:5432/congorag?sslmode=disable

# ── 发布凭据 ────────────────────────────────────────────────────
#
# scripts/release.mjs 按 GITHUB_TOKEN → GH_TOKEN → 仓库根 .env 的顺序找它。
# 需要的是一个 fine-grained PAT：权限 Contents: read and write，作用域只勾
# 这个仓库。**不要提交这个文件**——.env 已被 .gitignore 覆盖，这个
# .env.example 里也绝不写真实值。
#
# 另外注意 git remote 走 SSH：推 tag 用 SSH key，建 Release 用这个 PAT，
# 两个凭据来源不同（见 docs/releasing.md）。
GITHUB_TOKEN=

# ── 可选的覆盖项 ────────────────────────────────────────────────
#
# 下面每一项都对应 internal/platform/config.go 里的一个默认值。
# 全部留空 = 用程序内的默认值，那是正常开发的样子。
# 【改之前先看那边的注释】默认值大多是刻意的选择（尤其是监听地址），
# 不是"还没配"的占位。

# api 监听地址。默认 127.0.0.1:3210——只绑回环是安全基线的一部分，
# 本地开发不要改。改成 0.0.0.0 的唯一正当场合是 api 进容器（启动包），
# 而那边由 deployments/startup/.env.example 负责。
# CONGORAG_LISTEN_ADDR=127.0.0.1:3210

# 只用于日志和提示，真正的端口由监听地址决定。
# CONGORAG_PORT=3210

# debug | info | warn | error
# CONGORAG_LOG_LEVEL=info

# 原始文件目录。默认 ./data/documents，整个 ./data/ 都在 .gitignore 里。
# CONGORAG_DOCUMENTS_DIR=./data/documents

# 主密钥的十六进制字符串。留空 = 去 CONGORAG_MASTER_KEY_PATH 找文件，
# 文件不存在就随机生成一个并写回（0600）。本地开发留空即可。
# CONGORAG_MASTER_KEY=

# 主密钥文件路径。默认 ./data/master.key。
# CONGORAG_MASTER_KEY_PATH=./data/master.key

# tiktoken BPE 词表的本地缓存目录。默认 ./data/tiktoken-cache。
# 首次加载某个 encoding 会从网上拉几百 KB，之后走这里。
# CONGORAG_TIKTOKEN_CACHE_DIR=./data/tiktoken-cache

# 单次上传的最大请求体字节数，默认 32 MiB。填 0 或非法值会退回默认值，
# 不会变成"不限"（见 config.go 的 envBytes）。
# CONGORAG_MAX_UPLOAD_BYTES=33554432

# 集成测试用的独立测试库（不是开发库！）。只有设了它，需要真实数据库的
# 测试才会跑，否则 t.Skip。`make test-integration` 自己会 export 这个值，
# 手动跑 go test 时才需要。
# CONGORAG_TEST_DB_URL=postgres://postgres:postgres@127.0.0.1:5432/congorag_test?sslmode=disable
